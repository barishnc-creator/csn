{
  "name": "csn-desktop",
  "productName": "Cousy",
  "version": "0.2.0",
  "description": "Cousy masaüstü uygulaması",
  "author": "Cousy",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.csn.desktop",
    "productName": "Cousy",
    "artifactName": "Cousy-Kurulum-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cousy"
    },
    "publish": null,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "appx": {
      "identityName": "TidexTechnology.Cousy",
      "publisher": "CN=92519CC9-489D-4C57-B346-A84FDF5D6D30",
      "publisherDisplayName": "Tidex Technology",
      "displayName": "Cousy",
      "applicationId": "Cousy",
      "backgroundColor": "transparent",
      "languages": [
        "tr-TR",
        "en-US"
      ],
      "artifactName": "Cousy-Store-${version}.${ext}"
    }
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
